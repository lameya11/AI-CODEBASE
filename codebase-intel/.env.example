# Application Configuration
# Copy this file to .env and fill in your values

# ---- Database ----
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./codebase_intel.db
# PostgreSQL (for production/Docker):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codebase_intel

# ---- LLM Provider ----
# Set to "openai", "anthropic", or "none" (default)
LLM_PROVIDER=none

# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic API key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---- GitHub ----
# Optional: personal access token for cloning private repos or avoiding rate limits
GITHUB_TOKEN=

# ---- Ingestion Limits ----
# Maximum number of files to ingest per repository
MAX_FILES=2000

# Maximum size of a single file in bytes (default: 1 MB)
MAX_FILE_BYTES=1048576

# Maximum total size of a ZIP archive in bytes (default: 200 MB)
MAX_ZIP_BYTES=209715200

# ---- Search and RAG ----
# Number of top results to retrieve for RAG
TOP_K=8

# Token budget for RAG prompts (approximate, using chars/4)
TOKEN_BUDGET=6000

# ---- Analysis ----
# Maximum BFS depth for impact analysis
IMPACT_MAX_DEPTH=4

# Cyclomatic complexity threshold for warnings
COMPLEXITY_THRESHOLD=10

# ---- Storage ----
# Directory for storing vector indexes and other data
DATA_DIR=./data
